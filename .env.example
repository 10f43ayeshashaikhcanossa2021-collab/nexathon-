# Node environment (development | test | production)
NODE_ENV=development

# Server Port & Allowed CORS Origin
PORT=3000
APP_URL=http://localhost:3000

# Supabase PostgreSQL Pooled Connection (Server only)
DATABASE_URL=postgresql://postgres.slsqtsnlsdxwbhfazbax:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# JWT Configuration (HS256, >= 32 chars, no default in production)
JWT_SECRET=your-random-high-entropy-jwt-secret-min-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# Security & Cookies
COOKIE_SECURE=false
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
BCRYPT_COST=12
IP_HASH_SALT=your-random-salt-for-ip-hashing

# Optional Google Gemini AI Engine (Server only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Self-serve org signup (false in production)
ALLOW_SELF_SERVE_ORG_SIGNUP=false

# Demo & Test Configuration
ALLOW_DEMO_SEED=true
SEED_PASSWORD=Password123!
TEST_DATABASE_URL=

# Client Flags (Non-secret only)
VITE_API_BASE=/api
VITE_SHOW_DEMO_LOGINS=true
